<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= locals.pageTitle || (lang === 'en' ? settings.seoTitleEn : settings.seoTitle) %></title>
  <meta name="description" content="<%= locals.pageDesc || (lang === 'en' ? settings.seoDescriptionEn : settings.seoDescription) %>" />
  <meta name="keywords" content="<%= lang === 'en' ? settings.seoKeywordsEn : settings.seoKeywords %>" />
  <meta name="author" content="<%= settings.siteNameEn %>" />
  <% if (locals.staticMode) { %>
  <link rel="canonical" href="<%= locals.canonical %>" />
  <link rel="alternate" hreflang="zh" href="<%= locals.altZh %>" />
  <link rel="alternate" hreflang="en" href="<%= locals.altEn %>" />
  <link rel="alternate" hreflang="x-default" href="<%= locals.altZh %>" />
  <% } else { %>
  <link rel="canonical" href="<%= siteBase %><%= pagePath %>?lang=<%= lang %>" />
  <link rel="alternate" hreflang="zh" href="<%= siteBase %><%= pagePath %>?lang=zh" />
  <link rel="alternate" hreflang="en" href="<%= siteBase %><%= pagePath %>?lang=en" />
  <link rel="alternate" hreflang="x-default" href="<%= siteBase %><%= pagePath %>?lang=zh" />
  <% } %>

  <!-- Open Graph / 社交分享 -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= locals.pageTitle || (lang === 'en' ? settings.seoTitleEn : settings.seoTitle) %>" />
  <meta property="og:description" content="<%= locals.pageDesc || (lang === 'en' ? settings.seoDescriptionEn : settings.seoDescription) %>" />
  <meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'zh_CN' %>" />
  <meta property="og:url" content="<%= locals.staticMode ? locals.canonical : (siteBase + pagePath + '?lang=' + lang) %>" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- 结构化数据：组织信息（利于 SEO 富摘要） -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "<%= settings.siteNameEn %>",
    "alternateName": "<%= settings.siteName %>",
    "url": "<%= siteBase %>/",
    "description": "<%= lang === 'en' ? settings.seoDescriptionEn : settings.seoDescription %>",
    "email": "<%= settings.contactEmail %>",
    "telephone": "<%= settings.contactPhone %>",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Beijing",
      "addressCountry": "CN"
    }
  }
  </script>
</head>
