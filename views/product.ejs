<%- include('partials/head', { pageTitle: (lang === 'en' ? product.nameEn : product.name) + ' | ' + settings.shortName, pageDesc: (lang === 'en' ? product.descriptionEn : product.description) }) %>
<body>
<%- include('partials/header') %>
<main class="container section">
  <nav class="crumb">
    <a href="/?lang=<%= lang %>"><%= t.home %></a> <span>/</span>
    <% var brand = (brands || []).find(function(b){ return b.id === product.brandId; }); %>
    <% if (brand) { %><a href="/?lang=<%= lang %>#hot"><%= brand.code %></a> <span>/</span><% } %>
    <em><%= product.productCode || product.sku %></em>
  </nav>

  <div class="pdp">
    <div class="pdp-media">
      <img src="<%= product.image %>" alt="<%= lang==='en'?product.nameEn:product.name %>" />
    </div>

    <div class="pdp-info">
      <h1><%= lang==='en'?product.nameEn:product.name %></h1>

      <div class="pdp-meta">
        <% if (brand) { %><span class="pdp-chip"><%= brand.code %></span><% } %>
        <span class="pdp-chip"><%= lang==='en'?'Model':'型号' %>: <%= product.productCode || product.sku %></span>
        <% if (product.clicks) { %><span class="pdp-chip"><%= product.clicks.toLocaleString('en-US') %> <%= lang==='en'?'views':'次点击' %></span><% } %>
      </div>

      <div class="pdp-price">
        <% if (product.price > 0) { %>
          <span class="now"><i><%= product.currencySymbol || settings.currencySymbol %></i><%= product.price %></span>
          <% if (product.originalPrice > product.price) { %><span class="old"><%= product.currencySymbol || settings.currencySymbol %><%= product.originalPrice %></span><% } %>
        <% } else { %>
          <span class="now"><%= lang==='en'?'Inquire':'询价' %></span>
        <% } %>
      </div>

      <ul class="pdp-promise">
        <li><b>✔</b> <%= lang==='en'?'Genuine product — 10x compensation if fake':'原装正品，假一罚十' %></li>
        <li><b>✔</b> <%= lang==='en'?'Tax included, invoice available':'含税，可开票' %></li>
        <li><b>✔</b> <%= lang==='en'?'Lead time: ':'货期：' %><%= product.leadTime || (lang==='en'?'On request':'交期详询客服') %></li>
      </ul>

      <div class="pdp-actions">
        <% if (locals.staticMode) { %>
        <a class="pdp-btn primary" href="mailto:<%= settings.contactEmail %>?subject=<%= encodeURIComponent((product.productCode || product.sku) + ' - ' + (lang==='en'?'Inquiry':'询价')) %>&body=<%= encodeURIComponent((lang==='en'?'Hello, I would like to inquire about: ':'您好，我想咨询以下型号：') + (product.productCode || product.sku) + '\n' + (lang==='en'?'Quantity: ':'数量：')) %>"><%= lang==='en'?'Inquire Now':'立即询价' %></a>
        <% } else { %>
        <button class="pdp-btn primary" onclick="openInquiry('<%= (lang==='en'?product.nameEn:product.name).replace(/'/g,'') %>')"><%= lang==='en'?'Inquire Now':'立即询价' %></button>
        <% } %>
        <a class="pdp-btn" href="tel:<%= settings.contactPhone %>">📞 <%= settings.contactPhone %></a>
        <a class="pdp-btn" href="mailto:<%= settings.contactEmail %>?subject=<%= encodeURIComponent((product.productCode||product.sku) + ' - Inquiry') %>">✉️ <%= settings.contactEmail %></a>
      </div>

      <p class="pdp-desc"><%= lang==='en'?product.descriptionEn:product.description %></p>
    </div>
  </div>

  <!-- 产品信息 -->
  <section class="pdp-block">
    <h2><%= lang==='en'?'Product Details':'产品信息' %></h2>
    <table class="pdp-table">
      <tbody>
        <% if (brand) { %>
        <tr><th><%= lang==='en'?'Brand':'品牌' %></th><td><%= lang==='en'?brand.nameEn:brand.name %></td></tr>
        <% } %>
        <tr><th><%= lang==='en'?'Model / Part No.':'型号 / 产品编号' %></th><td><%= product.productCode || product.sku %></td></tr>
        <tr><th><%= lang==='en'?'Price':'价格' %></th><td><%= product.currencySymbol || settings.currencySymbol %><%= product.price %> <span class="muted"><%= lang==='en'?'(tax included)':'(含税)' %></span></td></tr>
        <tr><th><%= lang==='en'?'Lead Time':'货期' %></th><td><%= product.leadTime || (lang==='en'?'On request':'交期详询客服') %></td></tr>
        <tr><th><%= lang==='en'?'Availability':'库存' %></th><td><%= lang==='en'?'In stock / on request — please confirm with sales':'现货 / 备货，具体请联系客服确认' %></td></tr>
        <tr><th><%= lang==='en'?'Contact':'联系方式' %></th><td>TEL: <%= settings.contactPhone %> &nbsp;|&nbsp; Email: <%= settings.contactEmail %></td></tr>
      </tbody>
    </table>
  </section>

  <!-- 商品说明 -->
  <section class="pdp-block">
    <h2><%= lang==='en'?'Description':'商品说明' %></h2>
    <p class="pdp-text"><%= lang==='en'?product.descriptionEn:product.description %></p>
    <ul class="pdp-notes">
      <li><%= lang==='en'?'All products are sourced from authorized channels; please confirm model and quantity before ordering.':'所有商品均来自正规渠道，下单前请确认型号与数量。' %></li>
      <li><%= lang==='en'?'Bulk orders and technical selection support are available — contact our engineers.':'支持批量采购与技术选型，欢迎联系我们的工程师。' %></li>
    </ul>
  </section>

  <% if (related && related.length) { %>
    <div class="section-head" style="margin-top:30px;"><h2><%= lang==='en'?'Related Products':'相关推荐' %></h2></div>
    <div class="product-grid">
      <% related.forEach(function(p){ %>
        <a class="product-card" href="/product/<%= p.id %>?lang=<%= lang %>" data-cat="<%= p.categoryId %>" data-search="<%= (p.name+' '+(p.nameEn||'')+' '+(p.sku||'')).toLowerCase() %>">
          <div class="thumb"><img src="<%= p.image %>" alt="<%= lang==='en'?p.nameEn:p.name %>" loading="lazy" /></div>
          <div class="body">
            <div class="pname"><%= lang==='en'?p.nameEn:p.name %></div>
            <div class="price-row"><span class="price"><span class="cur"><%= p.currencySymbol || settings.currencySymbol %></span><%= p.price %></span></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "<%= (lang==='en'?product.nameEn:product.name).replace(/"/g,'') %>",
  "image": "<%= product.image %>",
  "description": "<%= (lang==='en'?product.descriptionEn:product.description).replace(/"/g,'') %>",
  "sku": "<%= product.productCode || product.sku %>",
  "brand": { "@type": "Brand", "name": "<%= brand ? brand.nameEn : 'SMC' %>" },
  "offers": { "@type": "Offer", "price": "<%= product.price %>", "priceCurrency": "<%= product.currency || settings.currency %>", "availability": "https://schema.org/InStock" }
}
</script>
<script src="/js/main.js"></script>
</body>
</html>
