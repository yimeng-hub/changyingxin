# ===== 站点基础 =====
PORT=3000
# 上线前务必改成随机长字符串，避免会话被伪造
SESSION_SECRET=change-me-to-a-random-long-string

# ===== 云端数据库（可选）=====
# 留空 = 本地 JSON 文件(data/db.json)
# 填 postgres = 腾讯云 TencentDB for PostgreSQL / 任意 PostgreSQL（用 jsonb 整存，零改业务代码）
DB_DRIVER=json
# PostgreSQL 连接串，例如：postgres://user:pass@host:5432/dbname
PG_CONNECTION_STRING=
# 是否启用 SSL（腾讯云等托管库通常为 true，填 false 可关闭）
PG_SSL=true

# ===== 云端图片存储（可选）=====
# 留空 = 本地 public/uploads
# 填 cos = 腾讯云 COS（S3 兼容对象存储）
STORAGE_DRIVER=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# Bucket 公网域名或自定义 CDN 域名（末尾不要带斜杠），例如 https://cdn.your-domain.com
UPLOAD_PUBLIC_BASE=
